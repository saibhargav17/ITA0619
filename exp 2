          "text": [
            "Specific Boundary:\n",
            "['Sunny', 'Warm', '?', 'Strong', '?', '?']\n",
            "\n",
            "General Boundary:\n",
            "['Sunny', '?', '?', '?', '?', '?']\n",
            "['?', 'Warm', '?', '?', '?', '?']\n",
            "['?', '?', '?', 'Strong', '?', '?']\n"
          ]
        }
      ],
      "source": [
        "data = [\n",
        "    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],\n",
        "    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],\n",
        "    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']\n",
        "]\n",
        "\n",
        "n = len(data[0]) - 1\n",
        "\n",
        "S = ['0'] * n\n",
        "G = [['?'] * n]\n",
        "\n",
        "for example in data:\n",
        "    x = example[:-1]\n",
        "    label = example[-1]\n",
        "\n",
        "    if label == 'Yes':\n",
        "        for i in range(n):\n",
        "            if S[i] == '0':\n",
        "                S[i] = x[i]\n",
        "            elif S[i] != x[i]:\n",
        "                S[i] = '?'\n",
        "\n",
        "        G = [g for g in G if all(\n",
        "            g[i] == '?' or g[i] == S[i] for i in range(n)\n",
        "        )]\n",
        "\n",
        "    else:\n",
        "        new_G = []\n",
        "        for g in G:\n",
        "            for i in range(n):\n",
        "                if g[i] == '?':\n",
        "                    if S[i] != '?':\n",
        "                        new_g = g.copy()\n",
        "                        new_g[i] = S[i]\n",
        "                        new_G.append(new_g)\n",
        "        G = new_G\n",
        "\n",
        "print(\"Specific Boundary:\")\n",
        "print(S)\n",
        "\n",
        "print(\"\\nGeneral Boundary:\")\n",
        "for g in G:\n",
        "    print(g)"
      ]
    }
  ]
